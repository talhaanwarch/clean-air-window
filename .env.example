# AcruxCore keeps the prompt, the tool catalog, the tool bindings and the traces.
# Sign up at https://acruxcore.com and create an API key under Account & keys.
ACRUXCORE_API_KEY=acx_sk_...
ACRUXCORE_BASE_URL=https://api.acruxcore.com/api/v1
# Where "open this trace" links point.
ACRUXCORE_DASHBOARD_URL=https://acruxcore.com
# Which prompt alias the app renders. Set it to staging to try a new version first.
PROMPT_ALIAS=production

# The model calls go straight to OpenRouter with your own key.
OPENROUTER_API_KEY=sk-or-...
CHAT_MODEL=google/gemma-4-31b-it:nitro
EMBED_MODEL=qwen/qwen3-embedding-8b

# The local news tool searches Google News through SerpApi (free plan: 250 searches a month).
# Without a key the tool tells the model that news is unavailable, and the app still works.
SERPAPI_KEY=

# Limits for a public demo: plans per browser session, and plans per day for the whole server.
SESSION_PLAN_LIMIT=5
DAILY_PLAN_LIMIT=150
